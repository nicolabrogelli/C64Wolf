00001  0000             *=$0810    ;SYS2064 TO RUN
00002  0810             
00003  0810  78                    SEI
00004  0811  A9 37                 LDA #$37
00005  0813  85 01                 STA $01
00006  0815  A9 18                 LDA #$18
00007  0817  8D 16 D0              STA $D016 ;SCREEN MULTICOLOUR MODE ENABLED
00008  081A  8D 18 D0              STA $D018 ;CHARSET MODE SET TO DISPLAY CUSTOM CHAR $2000-$2800
00009  081D  A9 00                 LDA #$00    ;SET COLOUR BLACK
00010  081F  8D 20 D0              STA $D020 ;TO BORDER
00011  0822  8D 21 D0              STA $D021 ;AND BACKGROUND
00012  0825  A9 0B                 LDA #$0B
00013  0827  8D 22 D0              STA $D022 ;CHAR MULTICOLOUR 1
00014  082A  A9 0C                 LDA #$0C
00015  082C  8D 23 D0              STA $D023 ;CHAR MULTICOLOUR 2
00016  082F             
00017  082F             ;DRAW MAIN SCREEN FROM MATRIX -
00018  082F             ;NOTE MAX 256 CHARS PER LOCATION ($0400-$04FF, $0500-$05FF,
00019  082F             ;$0600,$06FF,$0700,$07E8)
00020  082F             
00021  082F  A2 00                 LDX #$00
00022  0831             DRAWSCRN
00023  0831  BD 00 28              LDA MATRIX,X    ;GET DATA FROM SCREEN DATA FILE SCREEN.BIN
00024  0834  9D 00 04              STA $0400,X     ;PUT DATA INTO SCREEN RAM
00025  0837  BD 00 29              LDA MATRIX+$100,X ;FETCH THE NEXT 256 BYTES OF DATA FROM BINARY
00026  083A  9D 00 05              STA $0500,X    ;STORE THE NEXT 256 BYTES TO SCREEN
00027  083D  BD 00 2A              LDA MATRIX+$200,X ;... AND SO ON
00028  0840  9D 00 06              STA $0600,X
00029  0843  BD E8 2A              LDA MATRIX+$2E8,X
00030  0846  9D E8 06              STA $06E8,X
00031  0849  E8                    INX             ;INCREMENT ACCUMULATOR UNTIL 256 BYTES READ
00032  084A  D0 E5                 BNE DRAWSCRN    ;
00033  084C             
00034  084C  4C 4C 08              JMP * ;INFINITE LOOP
00035  084F             
00036  084F             ;IF USING A CROSS ASSEMBLER USE CORRECT PSEUDO COMMAND, OFFSET FOR IMPORTING BINARY DATA
00037  084F             
00038  084F             *          = $2000
00039  2000             CHARSET
00040  2000             INCBIN     CHARATTER.BIN
00041  3000             
00042  3000             *          = $2800
00043  2800             MATRIX
00044  2800             INCBIN     SCREEN.BIN
00045  33B8             

******* 3 Label(s) *******
CHARSET = $2000 
DRAWSCRN = $0831 
MATRIX = $2800 

******* 1 Unused label(s) *******
CHARSET

******* 1 Variable(s) *******
tgt_c64  = $0001
******* 1 Unused variables(s) *******
tgt_c64

